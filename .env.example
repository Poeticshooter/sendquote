# Supabase — create a free project at https://supabase.com
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Resend — create a free account at https://resend.com
RESEND_API_KEY=re_xxxxxxxxxxxx

# Razorpay — create an account at https://razorpay.com
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_xxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxx

# Site URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Email sender address (for Resend)
EMAIL_FROM_ADDRESS=quotes@yourdomain.com

# Admin panel credentials
ADMIN_EMAIL=admin@sendquote.in
# WARNING: Change this immediately after first login! Using placeholder exposes admin panel.
ADMIN_PASSWORD=change-this-immediately
