# =============================================================================
# SendQuote Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in your values
# cp .env.local.example .env.local
# =============================================================================

# ─── Supabase (Required) ────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── App ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── AI Providers (At least one required) ───────────────────────────────────
# Primary: Groq (fastest)
GROQ_API_KEY=your-groq-api-key
# Fallbacks:
GEMINI_API_KEY=your-gemini-api-key
OPENROUTER_API_KEY=your-openrouter-api-key
CEREBRAS_API_KEY=your-cerebras-api-key
MISTRAL_API_KEY=your-mistral-api-key

# ─── Payments - Razorpay (Required for payments) ───────────────────────────
NEXT_PUBLIC_RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-secret
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret

# ─── Google OAuth (Required for Google login) ─────────────────────────────
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ─── Email - Resend (Required for transactional emails) ────────────────────
RESEND_API_KEY=your-resend-api-key

# ─── Error Tracking - Sentry ────────────────────────────────────────────────
NEXT_PUBLIC_SENTRY_DSN=your-sentry-dsn
SENTRY_AUTH_TOKEN=your-sentry-auth-token

# ─── Analytics - PostHog ────────────────────────────────────────────────────
NEXT_PUBLIC_POSTHOG_KEY=your-posthog-key
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# ─── Security - Turnstile (CAPTCHA) ─────────────────────────────────────────
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key
TURNSTILE_SECRET_KEY=your-turnstile-secret-key

# ─── Feedback - Formbricks ──────────────────────────────────────────────────
NEXT_PUBLIC_FORMBRICKS_ENV_ID=your-formbricks-env-id
FORMBRICKS_API_KEY=your-formbricks-api-key

# ─── Cron Jobs (Shared secret for Vercel Cron) ────────────────────────────
CRON_SECRET=your-cron-secret

# ─── SEO ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_GOOGLE_VERIFICATION=your-google-verification-code
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# ─── Voice Assistant ────────────────────────────────────────────────────────
VOICE_REVENUE=100000
VOICE_USERS=500

# ─── Encryption (For sensitive data at rest) ──────────────────────────────
# ENCRYPTION_KEY=your-32-char-min-secret-key
