# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# AI
GROQ_API_KEY=your-groq-api-key
GEMINI_API_KEY=your-gemini-api-key

# Payments
NEXT_PUBLIC_RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-secret
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret

# Email
RESEND_API_KEY=your-resend-api-key
RESEND_FROM=quotes@yourdomain.com

# Error Tracking
NEXT_PUBLIC_SENTRY_DSN=your-sentry-dsn
SENTRY_AUTH_TOKEN=your-sentry-auth-token

# App
NEXT_PUBLIC_APP_URL=https://yourdomain.com

# Optional: CRM Integrations
# HUBSPOT_API_KEY=your-hubspot-key
# PIPEDRIVE_API_KEY=your-pipedrive-key

# Cron job protection (shared secret for Vercel Cron)
CRON_SECRET=your-cron-secret

# Optional: n8n Automation
# N8N_WEBHOOK_SECRET=your-n8n-secret

# Optional: SEO
# INDEXNOW_KEY=your-indexnow-key

# Google Search Console Verification
# NEXT_PUBLIC_GOOGLE_VERIFICATION=your-verification-code

# Google Analytics (GA4)
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# SMTP Fallback for Email (optional)
# SMTP_EMAIL=your@gmail.com
# SMTP_APP_PASSWORD=your-gmail-app-password

# Encryption (for sensitive data)
# ENCRYPTION_KEY=your-32-char-min-secret
