{
  "name": "sendquote",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.6.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:local": "NODE_OPTIONS=\"--max-old-space-size=512\" next build",
    "start": "next start",
    "lint": "eslint --max-warnings 200",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test tests/e2e/ --reporter=list",
    "analyze": "ANALYZE=true next build",
    "ci": "pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "smoke-test": "curl -s https://sendquote.in/api/health | grep -q 'ok' && echo '✅ Site healthy' || echo '❌ Site down'",
    "rollback": "vercel rollback --yes",
    "postdeploy": "echo 'Checking deployment...' && sleep 5 && for p in / /pricing /features /login; do code=$(curl -so /dev/null -w '%{http_code}' https://sendquote.in$p); [ $code -eq 200 ] && echo \"✅ $p -> $code\" || echo \"❌ $p -> $code\"; done",
    "prepare": "husky"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@react-pdf/renderer": "^4.5.1",
    "@sentry/nextjs": "^10.56.0",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.107.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^1.17.0",
    "motion": "^12.40.0",
    "next": "16.2.7",
    "next-themes": "^0.4.6",
    "posthog-js": "^1.381.0",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.8.1",
    "server-only": "^0.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "uuid": "^14.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.7",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.7",
    "shadcn": "^4.10.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.8"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix"
    ],
    "*.{json,md,yaml,css,scss}": [
      "eslint --fix"
    ]
  },
  "optionalDependencies": {
    "@rolldown/binding-darwin-x64": "^1.1.0",
    "@rollup/rollup-linux-x64-gnu": "*"
  }
}
