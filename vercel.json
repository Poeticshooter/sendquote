{
  "installCommand": "pnpm install",
  "buildCommand": "next build",
  "framework": "nextjs",
  "crons": [
    {
      "path": "/api/cron/run?task=daily",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/cron/run?task=weekly",
      "schedule": "0 6 * * 1"
    },
    {
      "path": "/api/cron/run?task=followup_process",
      "schedule": "0 9 * * *"
    }
  ]
}
